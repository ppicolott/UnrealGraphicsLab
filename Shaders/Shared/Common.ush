#pragma once

// Hash scramble constants, which are arbitrary, chosen only to mix the input
static const float2 GL_HASH_SCALE = float2(123.34, 456.21);
static const float GL_HASH_BIAS = 45.32;

float GL_Hash21(float2 P)
{
    P = frac(P * GL_HASH_SCALE);
    P += dot(P, P + GL_HASH_BIAS);
    return frac(P.x * P.y);
}

float GL_SDRoundedBox(float2 P, float2 HalfSize, float Radius)
{
    float2 Q = abs(P) - HalfSize + Radius;
    return length(max(Q, 0.0)) + min(max(Q.x, Q.y), 0.0) - Radius;
}

float GL_Fill(float D)
{
    return saturate(0.5 - D / fwidth(D));
}

float3 GL_Rainbow(float T)
{
    // Cosine palette (Inigo Quilez)
    return 0.5 + 0.5 * cos(6.28318 * (T + float3(0.0, 0.33, 0.67)));
}

float3 GL_Spectrum(float T)
{
    // Full hue wheel
    float3 C = abs(frac(T + float3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0;
    return saturate(C);
}

float GL_SDStar5(float2 P, float R, float InnerRatio)
{
    const float2 K1 = float2(0.809016994, -0.587785252);
    const float2 K2 = float2(-K1.x, K1.y);
    P.x = abs(P.x);
    P -= 2.0 * max(dot(K1, P), 0.0) * K1; // fold into one arm of the star
    P -= 2.0 * max(dot(K2, P), 0.0) * K2;
    P.x = abs(P.x);
    P.y -= R;
    float2 BA = InnerRatio * float2(-K1.y, K1.x) - float2(0.0, 1.0);
    float H = clamp(dot(P, BA) / dot(BA, BA), 0.0, R);
    return length(P - BA * H) * sign(P.y * BA.x - P.x * BA.y);
}