#pragma once

#include "/GraphicsLab/Shared/Common.ush"

// Seed offsets for GL_Hash21 (arbitrary nonintegers)
static const float CARD_SEED_OFFSET_X = 3.1;
static const float CARD_SEED_OFFSET_Y = 7.7;
static const float CARD_SEED_SIZE = 11.3;
static const float CARD_SEED_TILT = 17.9;

static const float CARD_ART_CENTER_Y = -0.13;
static const float CARD_ART_HALF_HEIGHT  = 0.22;

static const float CARD_SEED_STAR = 23.7;
static const float CARD_SEED_STAR_SIZE = 29.3;

static const float CARD_BASE_ROUGHNESS = 0.5;

static const float CARD_TEXT_GAMMA = 2.2;

// Card silhouette for the Opacity Mask (1 = inside the rounded card, 0 = outside)
float Card_OpacityMask(float2 UV, float Aspect, float Radius)
{
    float2 P = UV - 0.5;
    float D = GL_SDRoundedBox(P, float2(0.5 * Aspect, 0.5), Radius);
    return D <= 0.0 ? 1.0 : 0.0;
}

// Card layout masks (R = frame, G = art)
float2 Card_Layout(float2 UV, float Aspect, float Radius, float Border, float FullArt, float Overflow,
                   float ForegroundAspect, float BackgroundAspect, float BackgroundZoom, float2 BackgroundOffset,
                   float3 ViewTS, float ForegroundDepth, float BackgroundDepth,
                   out float2 ArtUV, out float ArtBounds, out float2 BackgroundUV, out float2 CardUV)
{
    float2 P = UV - 0.5;
    
    // Parallax
    float2 ViewShift = ViewTS.xy / max(ViewTS.z, 0.25);
    float2 PF = P + ViewShift * ForegroundDepth;
    float2 PB = P - ViewShift * BackgroundDepth;
    
    float2 CardHalf = float2(0.5 * Aspect, 0.5);
    
    CardUV = P / (2.0 * CardHalf) + 0.5;
    
    float Card = GL_Fill(GL_SDRoundedBox(P, CardHalf, Radius));
    float Inner = GL_Fill(GL_SDRoundedBox(P, CardHalf - Border, max(Radius - Border, 0.0)));
    float Frame = Card - Inner;
    
    // V grows downwards, so negative y = top
    float2 ArtHalf = float2(CardHalf.x - 2.0 * Border, CARD_ART_HALF_HEIGHT);
    float2 ArtCenter = float2(0.0, CARD_ART_CENTER_Y);
    float ArtWindow = GL_Fill(GL_SDRoundedBox(P - ArtCenter, ArtHalf, 0.01));
    float Art = FullArt > 0.5 ? Inner : ArtWindow;
    float2 ArtBoxCenter = FullArt > 0.5 ? float2(0.0, 0.0) : ArtCenter;
    float2 WindowHalf = FullArt > 0.5 ? CardHalf - Border : ArtHalf;
    float2 ArtBoxHalf = WindowHalf + Overflow;
    
    ArtUV = (PF - ArtBoxCenter) / (2.0 * ArtBoxHalf) + 0.5;
    float FitRatio = ForegroundAspect / (ArtBoxHalf.x / ArtBoxHalf.y);
    float2 FitScale = FitRatio > 1.0 ? float2(1.0, FitRatio) : float2(1.0 / FitRatio, 1.0);
    ArtUV = (ArtUV - 0.5) * FitScale + 0.5;
    
    ArtBounds = GL_Fill(GL_SDRoundedBox(PF - ArtBoxCenter, ArtBoxHalf, 0.0));
    ArtBounds *= all(ArtUV == saturate(ArtUV)) ? 1.0 : 0.0;
    
    BackgroundUV = (PB - ArtBoxCenter) / (2.0 * WindowHalf) + 0.5;
    float CoverRatio = BackgroundAspect / (WindowHalf.x / WindowHalf.y);
    float2 CoverScale = CoverRatio > 1.0 ? float2(1.0 / CoverRatio, 1.0) : float2(1.0, CoverRatio);
    
    float Zoom = max(BackgroundZoom, 1.0);
    float2 Visible = CoverScale / Zoom;
    BackgroundUV = (BackgroundUV - 0.5) * Visible + 0.5 + BackgroundOffset * (1.0 - Visible) * 0.5;
    
    return float2(Frame, Art);
}

float Card_Sparkle(float2 UV, float3 ViewTS, float Density, float Sharpness, float Shape)
{
    float2 Grid = UV * Density;
    float2 Cell = floor(Grid);
    float2 Local = frac(Grid) - 0.5; // -0.5..0.5
    
    // Random flake shape
    float2 Offset = float2(GL_Hash21(Cell + CARD_SEED_OFFSET_X), GL_Hash21(Cell + CARD_SEED_OFFSET_Y)) - 0.5;
    float Size = lerp(0.08, 0.25, GL_Hash21(Cell + CARD_SEED_SIZE));
    float2 FlakePos = Local - Offset * 0.5;
    float DiamondDist = abs(FlakePos.x) + abs(FlakePos.y);
    float RoundDist = length(FlakePos);
    float Dist = Shape > 0.5 ? DiamondDist : RoundDist; // 0 = round, 1 = diamond
    float Dot = saturate(1.0 - Dist / Size); // 1 at the center, 0 at the edge
    Dot *= Dot; // softer falloff
    
    // Random flake tilt
    float2 Tilt = float2(GL_Hash21(Cell), GL_Hash21(Cell + CARD_SEED_TILT)) * 2.0 - 1.0;
    float3 FacetNormal = normalize(float3(Tilt * 0.5, 1.0));
    float Align = saturate(dot(normalize(ViewTS), FacetNormal));
    
    return Dot * pow(Align, Sharpness);
}

float3 Card_Sheen(float2 UV, float3 ViewTS, float Frequency, float Width, float ViewInfluence, float Whiteness)
{
    float Phase = (UV.x + UV.y) * Frequency // diagonal stripes
                + (ViewTS.x + ViewTS.y) * ViewInfluence; // slide with the angle
    float Dist = abs(frac(Phase) - 0.5);
    float Band = smoothstep(Width, 0.0, Dist);
    float3 Color = lerp(GL_Spectrum((frac(Phase) - 0.5) / (2.0 * Width) + 0.5), 1.0, Whiteness);
    return Band * Color;
}

float3 Card_HoloFoil(float2 UV, float3 ViewTS, float Frequency, float ViewInfluence)
{
    float Phase = (UV.x + UV.y) * Frequency // diagonal bands across the card
                + (ViewTS.x + ViewTS.y) * ViewInfluence; // shifted by the angle
    // return GL_Rainbow(Phase);
    return GL_Spectrum(Phase);
}

float Card_Stars(float2 UV, float Aspect, float Density, float Size, float Coverage)
{
    float2 Grid = UV * float2(Aspect, 1.0) * Density;
    float2 Cell = floor(Grid);
    float2 Local = frac(Grid) - 0.5; // -0.5..0.5
    
    float Present = GL_Hash21(Cell + CARD_SEED_STAR) < Coverage ? 1.0 : 0.0;
    float Radius = Size * lerp(0.5, 1.0, GL_Hash21(Cell + CARD_SEED_STAR_SIZE));
    float2 Offset = float2(GL_Hash21(Cell + CARD_SEED_OFFSET_X), GL_Hash21(Cell + CARD_SEED_OFFSET_Y)) - 0.5;
    float2 StarPos = Local - Offset * (1.0 - 2.0 * Radius);
    StarPos.y = -StarPos.y; // V grows downwards, flip so the star points up
    
    float D = GL_SDStar5(StarPos, Radius, 0.45);
    float AA = length(fwidth(Grid));
    return saturate(0.5 - D / AA) * Present;
}

// Procedural foil masks: 0 = stars, 1 = diagonal stripes, 2 = diamonds
float Card_FoilPattern(float2 UV, float Aspect, float Type, float Density, float Size, float Coverage)
{
    float2 Grid = UV * float2(Aspect, 1.0) * Density;
    float2 Local = frac(Grid) - 0.5; // -0.5..0.5

    float Stars = Card_Stars(UV, Aspect, Density, Size, Coverage);
    float Stripes = GL_Fill(abs(frac(Grid.x + Grid.y) - 0.5) - Size);
    float Diamonds = GL_Fill(abs(Local.x) + abs(Local.y) - Size);

    float T = round(Type);
    return T < 0.5 ? Stars : T < 1.5 ? Stripes : Diamonds;
}

// Surface response of the frame and art foil (returns Roughness)
float Card_Surface(float MetalAmount, float HoloAmount, float ArtFoilAmount,
                   float MetalRoughness, float HoloRoughness,
                   float3 MetalNormal, float MetalNormalStrength,
                   out float Metallic, out float3 Normal)
{
    float Roughness = lerp(CARD_BASE_ROUGHNESS, MetalRoughness, MetalAmount);
    Roughness = lerp(Roughness, HoloRoughness, HoloAmount);
    
    Metallic = max(max(HoloAmount, MetalAmount), ArtFoilAmount);
    
    Normal = lerp(float3(0.0, 0.0, 1.0), MetalNormal, MetalAmount * MetalNormalStrength);
    
    return Roughness;
}

// Glow from the holo frame, sparkles and sheen, hidden under the text
float3 Card_Emissive(float3 Holo, float HoloIntensity, float HoloAmount, float Sparkles, float3 Sheen, float TextAmount)
{
    float3 Glow = Holo * HoloIntensity * HoloAmount + Sparkles + Sheen;
    return Glow * (1.0 - TextAmount);
}

// Card color built bottom to top: frame, card, art window, foreground, art foil, overlay, text
float3 Card_BaseColor(float2 Layout, float3 CardBaseColor,
                      float3 FrameColor, float3 MetalColor, float MetalAmount,
                      float3 Holo, float HoloAmount,
                      float3 ArtWindow, float ArtWindowOpacity,
                      float3 Foreground, float ForegroundMask,
                      float ArtFoilAmount,
                      float4 Text, float TextAmount)
{
    float Frame = Layout.x;
    float Art = Layout.y;
    
    // Frame: Plain color, then metal, then holo
    float3 FrameRGB = lerp(FrameColor, MetalColor, MetalAmount);
    FrameRGB = lerp(FrameRGB, Holo, HoloAmount);
    
    float3 Color = lerp(CardBaseColor, FrameRGB, Frame);
    Color = lerp(Color, ArtWindow, Art * ArtWindowOpacity);
    Color = lerp(Color, Foreground, ForegroundMask);
    Color = lerp(Color, Holo, ArtFoilAmount);
    
    // Same gamma the graph's Power node applied to the text layer
    float3 TextColor = pow(Text.rgb, CARD_TEXT_GAMMA);
    return lerp(Color, TextColor, TextAmount);
}